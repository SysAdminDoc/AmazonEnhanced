      "pathname": "/s",
      "root": "#search",
      "core": "[data-component-type=\"s-search-result\"]",
      "sponsored": "[data-component-type=\"sp-sponsored-result\"]",
      "label": ".puis-sponsored-label-text"
    },
    "pdp": {
